# Copy to .env.prod and change every value before deploy:
#   cp .env.prod.example .env.prod
# Never commit .env.prod to Git.

# ----- PostgreSQL -----
POSTGRES_DB=transport_erp
POSTGRES_USER=transport_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password_32chars

# ----- JWT (min 32+ random characters; base64 preferred) -----
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_replace_with_long_random_base64_secret_value
JWT_EXPIRATION=86400000

# ----- Bootstrap (first boot only) -----
# true  = create DEMO company + admin on empty DB (first deploy)
# false = skip bootstrap (use after your seed SQL is loaded)
APP_BOOTSTRAP_ENABLED=true
APP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_Admin@StrongPass

# ----- Public HTTP port on the VM -----
HOST_HTTP_PORT=80
